              "id": "cond-finance-live-webhook",
              "leftValue": "={{ $json.hasLiveSlackWebhook }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
