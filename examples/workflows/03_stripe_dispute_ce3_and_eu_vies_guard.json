    {
      "parameters": {
        "jsCode": "const ctx = $('Seed Dispute & Order Context').first().json || {};\nconst ce3 = $('Visa CE 3.0 120d-365d & 18k Char Lint').first().json || {};\nconst vies = $('EU VAT VIES Consultation Proof').first().json || {};\nconst acctRes = $('RevClamp Hiring Watchlist (Account Verification)').first()?.json || {};\n\nconst ce3Eligible = Boolean(ce3.ce3Eligible || ce3.ce3Qualification?.qualified);\nconst ce3Status = ce3.ce3Qualification?.status || 'EVALUATED';\nconst utf16Units = Number(ce3.utf16CodeUnits || 0);\nconst utf16Safe = utf16Units <= 18000;\n\nconst vatValid = Boolean(vies.valid);\nconst vatAction = vies.action || 'MANUAL_REVIEW';\nconst vatDirective = vies.sellerStatutoryTerminology?.directiveArticle || 'Council Directive 2006/112/EC';\n\nconst accountBoard = acctRes.boardKey || acctRes.board_key || (Array.isArray(acctRes.boards) ? `${acctRes.boards.length} watched board(s)` : 'verified');\n\nconst rawWebhook = String(ctx.slackWebhookUrl || '').trim();\nconst hasLiveSlackWebhook = rawWebhook.startsWith('https://hooks.slack.com/services/') && !rawWebhook.includes('<');\n\nconst financeBrief = [\n  `*Finance & Dispute Compliance Triage (${ce3.disputeId || ctx.disputeId})*`,\n  `- Visa CE 3.0 (120d-365d): eligible=${ce3Eligible} (${ce3Status}) | submit=${Boolean(ce3.submit)} (non-destructive staging)`,\n  `- Stripe Evidence UTF-16 Budget: ${utf16Units} / 18,000 units (${utf16Safe ? 'SAFE' : 'OVERFLOW_RISK'})`,\n  `- EU VAT VIES Check: valid=${vatValid} | action=${vatAction} (${vatDirective})`,\n  `- Merchant / Buyer Account Signal: ${accountBoard}`\n].join('\\n');\n\nreturn [{\n  json: {\n    disputeId: ce3.disputeId || ctx.disputeId,\n    ce3Eligible,\n    ce3Status,\n    utf16CodeUnits: utf16Units,\n    utf16Safe,\n    vatValid,\n    vatAction,\n    accountBoard,\n    requiresManualFinanceReview: !ce3Eligible || !vatValid || !utf16Safe,\n    slackWebhookUrl: rawWebhook,\n    hasLiveSlackWebhook,\n    financeBrief\n  }\n}];"
      },
      "id": "b1030003-0003-4000-8000-000000000009",
      "name": "Assemble Finance & Dispute Triage Receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        560
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
