{
  "name": "n8n-nodes-revclamp",
  "version": "1.0.4",
  "description": "Track company career pages (Greenhouse, Ashby, Lever, SmartRecruiters, Workday) and trigger n8n workflows when new roles open, salaries change, or roles close.",
  "license": "MIT",
  "author": {
    "name": "RevClamp Team",
    "email": "support@revclamp.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhphong09t2/n8n-nodes-revclamp.git"
  },
  "homepage": "https://revclamp.com/tools/ats-hiring-watchlist",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ats",
    "recruiting",
    "hiring-signals",
    "greenhouse",
    "ashby",
    "lever",
    "workday",
    "revclamp"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "verify:dist": "node --check dist/credentials/RevClampApi.credentials.js && node --check dist/nodes/RevClampHiringWatchlist/RevClampHiringWatchlist.node.js && node --check dist/nodes/RevClampHiringWatchlistTrigger/RevClampHiringWatchlistTrigger.node.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@n8n/node-cli": "0.57.4",
    "eslint": "9.32.0",
    "n8n-workflow": "2.16.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/RevClampApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/RevClampHiringWatchlist/RevClampHiringWatchlist.node.js",
      "dist/nodes/RevClampHiringWatchlistTrigger/RevClampHiringWatchlistTrigger.node.js"
    ]
  }
}
