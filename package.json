{
  "name": "n8n-nodes-revclamp",
  "version": "1.0.1",
  "description": "Track company career pages (Greenhouse, Ashby, Lever, SmartRecruiters, Workday) and trigger n8n workflows when new roles open, salaries change, or roles close.",
  "license": "MIT",
  "author": {
    "name": "RevClamp Team",
    "email": "support@revclamp.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhphong09t2/n8n-nodes-revclamp.git"
  },
  "homepage": "https://revclamp.com/tools/ats-hiring-watchlist",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ats",
    "recruiting",
    "hiring-signals",
    "greenhouse",
    "ashby",
    "lever",
    "workday",
    "revclamp"
  ],
  "main": "credentials/RevClampApi.credentials.js",
  "files": [
    "credentials",
    "nodes",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "node --check credentials/RevClampApi.credentials.js && node --check nodes/RevClampHiringWatchlist/RevClampHiringWatchlist.node.js && node --check nodes/RevClampHiringWatchlistTrigger/RevClampHiringWatchlistTrigger.node.js"
  },
  "dependencies": {},
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "credentials/RevClampApi.credentials.js"
    ],
    "nodes": [
      "nodes/RevClampHiringWatchlist/RevClampHiringWatchlist.node.js",
      "nodes/RevClampHiringWatchlistTrigger/RevClampHiringWatchlistTrigger.node.js"
    ]
  }
}
